{
	"name": "you-mean",
	"version": "1.0.7",
	"private": true,
	"description": "Imagine text through Google search suggestions.",
	"keywords": [
		"itp",
		"google",
		"generative",
		"ai",
		"llm"
	],
	"homepage": "https://frontiernerds.com/projects/you-mean",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/you-mean.git"
	},
	"license": "CC-BY-NC-SA-4.0",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown --tsconfig tsconfig.build.json --platform neutral --dts",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "wrangler dev",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && wrangler deploy",
		"test": "vitest run --exclude \"**/*.integration.test.ts\"",
		"test:integration": "vitest run test/index.integration.test.ts"
	},
	"dependencies": {
		"lodash": "^4.18.1"
	},
	"devDependencies": {
		"@kitschpatrol/dict-en-wiktionary": "^1.6.0",
		"@kitschpatrol/shared-config": "^8.13.1",
		"@types/lodash": "^4.17.26",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"shx": "^0.4.0",
		"skills": "^1.7.2",
		"tsdown": "^0.23.1",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
