		"@types/lodash": "^4.17.24",
		"@types/node": "~24.13.3",
		"bumpp": "^12.0.0",
		"netlify-cli": "^27.0.0",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	},
	"packageManager": "pnpm@11.15.0",
	"engines": {
		"node": ">=24.16.0"
	}
